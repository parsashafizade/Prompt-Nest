{
  "name": "prompt-nest-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "tsc -b --pretty false",
    "audit": "npm run check && npm test && npm run build && node scripts/audit.mjs",
    "package": "npm run build && cd dist && zip -FS -qr ../prompt-nest-extension.zip ."
  },
  "dependencies": {
    "idb": "^8.0.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.6",
    "@fontsource/vazirmatn": "^5.2.6",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/webextension-polyfill": "^0.12.3",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
